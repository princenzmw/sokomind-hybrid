# Firebase Web App Configuration (Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mandatory Firebase App Check for Firebase AI Logic
# Use either a reCAPTCHA site key OR a debug token registered in Firebase Console -> App Check -> Apps -> Manage debug tokens.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
